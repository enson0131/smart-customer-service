---
config:
  flowchart:
    curve: basis
    diagramPadding: 24
    htmlLabels: false
    nodeSpacing: 35
    rankSpacing: 46
  theme: base
  themeVariables:
    edgeLabelBackground: '#FFFFFF'
    fontFamily: system-ui, sans-serif
    fontSize: 16px
    lineColor: '#69818E'
---
graph TD;
	__start__([收到消息]):::first
	intent(意图识别)
	direct(执行确定指令)
	respond(组装客服答复)
	remember(保存对话)
	__end__([本轮结束]):::last
	__start__ --> intent;
	agent\3a__end__ --> respond;
	direct --> remember;
	intent -.-> agent\3a__start__;
	intent -.-> direct;
	respond --> remember;
	remember --> __end__;
	subgraph agent
	agent\3a__start__(<p>__start__</p>)
	agent\3amodel(模型决策)
	agent\3atools(执行工具 / 等待补充)
	agent\3acontinue_tool_batch\2ebefore_model(before_model：续派剩余工具)
	agent\3aModelCallLimitMiddleware\2ebefore_model(检查模型调用次数)
	agent\3aModelCallLimitMiddleware\2eafter_model(记录模型调用次数)
	agent\3aprepare_tool_batch\2eafter_model(after_model：保存新批次)
	agent\3a__end__(<p>__end__</p>)
	agent\3aModelCallLimitMiddleware\2eafter_model -.-> agent\3a__end__;
	agent\3aModelCallLimitMiddleware\2eafter_model -.-> agent\3acontinue_tool_batch\2ebefore_model;
	agent\3aModelCallLimitMiddleware\2eafter_model -.-> agent\3atools;
	agent\3aModelCallLimitMiddleware\2ebefore_model -.-> agent\3a__end__;
	agent\3aModelCallLimitMiddleware\2ebefore_model -.-> agent\3amodel;
	agent\3a__start__ --> agent\3acontinue_tool_batch\2ebefore_model;
	agent\3acontinue_tool_batch\2ebefore_model -.-> agent\3aModelCallLimitMiddleware\2ebefore_model;
	agent\3acontinue_tool_batch\2ebefore_model -.-> agent\3atools;
	agent\3amodel --> agent\3aprepare_tool_batch\2eafter_model;
	agent\3aprepare_tool_batch\2eafter_model --> agent\3aModelCallLimitMiddleware\2eafter_model;
	agent\3atools -.-> agent\3a__end__;
	agent\3atools -.-> agent\3acontinue_tool_batch\2ebefore_model;
	end
	classDef default fill:#F2F8F6,stroke:#82A99C,color:#204A40
	classDef first fill:#EDF2F5,stroke:#ADBCC5,color:#344957
	classDef last fill:#EDF2F5,stroke:#ADBCC5,color:#344957
