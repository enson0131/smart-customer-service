{
  "name": "smart-customer-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@langchain/core": "^1.3.4",
    "@langchain/langgraph": "^1.6.0",
    "@langchain/langgraph-checkpoint": "^1.2.2",
    "@langchain/openai": "^1.8.0",
    "langchain": "^1.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@types/node": "^26.6.6",
    "tsx": "4.20.6",
    "typescript": "^7.0.2",
    "undici": "7.29.1",
    "wrangler": "4.151.0"
  },
  "scripts": {
    "knowledge": "tsx scripts/worker-knowledge.ts",
    "precheck": "npm run knowledge",
    "check": "tsc --noEmit",
    "pretest": "npm run knowledge",
    "test": "tsx --test tests/*.test.ts",
    "db:local": "wrangler d1 execute smart-customer-service-db --local --file workers/storage/schema.sql",
    "predev": "npm run knowledge",
    "dev": "tsx scripts/dev.ts",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "verify": "tsx scripts/verify-worker.ts",
    "graph": "tsx scripts/export-flow.ts",
    "dev:worker": "npm run db:local && wrangler dev --port 8000"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
